  "services": [
    {
      "id": "service_feeder_substation_ss2",
      "name": "Feeder substation SS-2 (33/11 kV)",
      "site": "Power",
      "people_served": 120000,
      "safety_severity": 3,
      "baseline_outage_hours": 12.0,
      "backup": "None at the substation",
      "reason": "Feeds the north zone (about a quarter of the city) plus the water plant, the hospital and the signal network. Long outages are a health risk in heat and for people on home oxygen or other powered equipment. 12 h covers inspecting relays and breakers and restoring manually after a cyber incident.",
      "scenario_assumption": true
    },
    {
      "id": "service_residential_power_north",
      "name": "Residential power, North zone",
      "site": "Power",
      "people_served": 120000,
      "safety_severity": 2,
      "baseline_outage_hours": 12.0,
      "backup": "Inverters in some homes (not counted)",
      "reason": "Mainly economic and daily-life disruption; the health risk is scored on the substation and hospital rows, so it is not counted twice.",
      "scenario_assumption": true
    },
    {
      "id": "service_water_pumping",
      "name": "Water treatment plant, pumping (27 MLD)",
      "site": "Water",
      "people_served": 200000,
      "safety_severity": 3,
      "baseline_outage_hours": 24.0,
      "backup": "Plant DG set runs controls and SCADA only, not the main pumps",
      "reason": "27 MLD = 2 lakh people × 135 litres per person per day, the CPHEEO norm for cities with sewerage. 24 h covers a safe pump restart and water-quality checks before supply resumes.",
      "scenario_assumption": true
    },
    {
      "id": "service_chlorine_dosing",
      "name": "Chlorine dosing",
      "site": "Water",
      "people_served": 200000,
      "safety_severity": 4,
      "baseline_outage_hours": 72.0,
      "backup": "Online residual-chlorine alarm; manual sampling",
      "reason": "Under-dosing risks a waterborne disease outbreak; over-dosing makes water unsafe to drink. 72 h covers flushing mains, cleaning storage tanks, lab tests and lifting a boil-water notice.",
      "scenario_assumption": true
    },
    {
      "id": "service_reservoir_level",
      "name": "Reservoir level monitoring",
      "site": "Water",
      "people_served": 200000,
      "safety_severity": 2,
      "baseline_outage_hours": 8.0,
      "backup": "Manual level readings by plant staff",
      "reason": "False readings cause overflow or pumps running dry; costly and disruptive, but staff can switch to manual readings within a shift.",
      "scenario_assumption": true
    },
    {
      "id": "service_piped_water",
      "name": "Piped water supply, plant service area",
      "site": "Water",
      "people_served": 200000,
      "safety_severity": 3,
      "baseline_outage_hours": 24.0,
      "backup": "Service reservoirs + household overhead tanks and sumps",
      "reason": "Most Indian cities supply water in scheduled slots and households store it, so the buffer is about half a day on average. Informal settlements with little storage are hit at the first missed slot, so the average understates their risk.",
      "scenario_assumption": true
    },
    {
